@model Alertify.ViewModels.Profile.EditProfileViewModel
@{
    ViewData["Title"] = "Editar Perfil";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Profile/Edit.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <header class="mb-4 text-center text-md-start">
                <h2 class="fw-bold text-dark mb-0">Editar Perfil</h2>
                <p class="text-muted mb-0">Actualiza tu información personal</p>
            </header>

            <div class="edit-container p-4 p-md-5">
                <form asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Por favor revisa los errores indicados abajo.
                        </div>
                    }

                    <div class="mb-4">
                        <span class="section-label">Información Básica</span>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control" placeholder="Nombre" />
                                    <label asp-for="FirstName">Nombre</label>
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small ms-1"></span>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FirstLastName" class="form-control" placeholder="Primer Apellido" />
                                    <label asp-for="FirstLastName">Primer Apellido</label>
                                </div>
                                <span asp-validation-for="FirstLastName" class="text-danger small ms-1"></span>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="SecondLastName" class="form-control" placeholder="Segundo Apellido" />
                                    <label asp-for="SecondLastName">Segundo Apellido</label>
                                </div>
                                <span asp-validation-for="SecondLastName" class="text-danger small ms-1"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <span class="section-label">Contacto e Identificación</span>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="NationalID" class="form-control" placeholder="Cédula de Identidad" />
                                    <label asp-for="NationalID">Cédula de Identidad</label>
                                </div>
                                <span asp-validation-for="NationalID" class="text-danger small ms-1"></span>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Phone" class="form-control" placeholder="Teléfono" />
                                    <label asp-for="Phone">Teléfono / Celular</label>
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small ms-1"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <span class="section-label">Foto de Perfil</span>
                        <div class="upload-box p-4 text-center">
                            <input asp-for="Photo" type="file" class="upload-input" accept="image/jpeg,image/jpg,image/png" />
                            <div class="py-3">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
                                    <i class="bi bi-camera-fill fs-4"></i>
                                </div>
                                <h6 class="fw-bold mb-1">Subir nueva foto</h6>
                                <p class="text-muted small mb-0">Arrastra una imagen aquí o haz clic para seleccionar</p>
                                <small class="text-muted opacity-75" style="font-size: 0.7rem;">JPG o PNG, Máx 5MB</small>
                            </div>
                        </div>
                        <span asp-validation-for="Photo" class="text-danger small ms-1"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-controller="Profile" asp-action="Index" class="text-decoration-none text-secondary fw-bold px-3">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm fw-bold">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}