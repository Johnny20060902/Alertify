@model Alertify.Models.Station

@{
    ViewData["Title"] = "Editar Estación";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title mb-4">Editar Estación</h3>

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="StationID" />

                        <!-- NOMBRE -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Nombre de la Estación</label>
                            <input asp-for="Name" class="form-control" required/>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- TIPO DE SERVICIO -->
                        <div class="mb-3">
                            <label asp-for="ServiceType" class="form-label">Tipo de Servicio</label>
                            <select asp-for="ServiceType" class="form-select" required>
                                <option value="">-- Seleccione tipo --</option>
                                <option>Bomberos</option>
                                <option>Policía</option>
                                <option>Ambulancia</option>
                                <option>Defensa Civil</option>
                                <option>Otro</option>
                            </select>
                            <span asp-validation-for="ServiceType" class="text-danger small"></span>
                        </div>

                        <!-- DIRECCIÓN -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Dirección</label>
                            <input asp-for="Address" class="form-control"/>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- TELÉFONO -->
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Teléfono</label>
                            <input asp-for="Phone" class="form-control"/>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <!-- LATITUD -->
                        <div class="mb-3">
                            <label asp-for="Latitude" class="form-label">Latitud</label>
                            <input asp-for="Latitude" id="Latitude" class="form-control" readonly />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>

                        <!-- LONGITUD -->
                        <div class="mb-3">
                            <label asp-for="Longitude" class="form-label">Longitud</label>
                            <input asp-for="Longitude" id="Longitude" class="form-control" readonly />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>

                        <!-- ESTADO -->
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Estado</label>
                            <select asp-for="Status" class="form-select">
                                <option>Activo</option>
                                <option>Inactivo</option>
                                <option>Mantenimiento</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <!-- BOTONES -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MAPA -->
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h5 class="card-title">Actualizar Ubicación en el Mapa</h5>
                    <p class="text-muted small">Haz clic en el mapa para actualizar la ubicación</p>
                    <div id="map" style="height: 500px; border-radius: 8px;" class="border"></div>
                    <p class="text-muted small mt-2">
                        <i class="bi bi-info-circle"></i> Los valores de Latitud y Longitud se actualizarán al hacer clic en el mapa
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Obtener las coordenadas actuales
        const currentLat = parseFloat(document.getElementById("Latitude").value) || -16.5;
        const currentLng = parseFloat(document.getElementById("Longitude").value) || -68.15;

        // Inicializar mapa
        var map = L.map('map').setView([currentLat, currentLng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 19,
        }).addTo(map);

        let marker;

        // Crear marcador en coordenadas actuales
        if (currentLat && currentLng) {
            marker = L.marker([currentLat, currentLng]).addTo(map)
                .bindPopup(`<b>Ubicación actual</b><br/>Lat: ${currentLat.toFixed(6)}<br/>Lng: ${currentLng.toFixed(6)}`)
                .openPopup();
        }

        // Evento de clic en el mapa
        map.on('click', function (e) {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;

            // Actualizar campos de entrada con formato correcto (punto como separador)
            const latStr = lat.toFixed(6).replace(/,/g, '.');
            const lngStr = lng.toFixed(6).replace(/,/g, '.');
            
            document.getElementById("Latitude").value = latStr;
            document.getElementById("Longitude").value = lngStr;

            // Eliminar marcador anterior
            if (marker) {
                map.removeLayer(marker);
            }

            // Crear nuevo marcador
            marker = L.marker([lat, lng]).addTo(map)
                .bindPopup(`<b>Nueva ubicación</b><br/>Lat: ${latStr}<br/>Lng: ${lngStr}`)
                .openPopup();

            // Centrar mapa
            map.setView([lat, lng], 16);
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
