@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem;"></i>
            </div>

            <h1 class="display-4 fw-bold mb-3">Algo salió mal</h1>
            <p class="text-muted mb-4">
                Lo sentimos, ha ocurrido un error inesperado. Nuestro equipo ha sido notificado y trabajará para resolverlo.
            </p>

            @if (!string.IsNullOrEmpty(Model.RequestId))
            {
                <div class="alert alert-light border mb-4" role="alert">
                    <small class="text-muted">
                        <strong>ID de solicitud:</strong> @Model.RequestId
                    </small>
                </div>
            }

            <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house-fill me-2"></i>Volver al inicio
                </a>
                <button onclick="history.back()" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i>Página anterior
                </button>
            </div>
        </div>
    </div>
</div>