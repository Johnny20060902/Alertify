@model Alertify.ViewModels.Citizen.CreateEmergencyViewModel
@{
    ViewData["Title"] = "Reportar Emergencia";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Reportar Emergencia
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Importante:</strong> Proporciona la información más detallada posible para que podamos ayudarte de manera efectiva.
                    </div>

                    <form asp-controller="Citizen" asp-action="CreateEmergency" method="post" enctype="multipart/form-data" id="emergencyForm">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Por favor corrige los errores del formulario.
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="EmergencyCategory" class="form-label fw-bold"></label>
                                <select asp-for="EmergencyCategory" class="form-select" required>
                                    <option value="">Seleccione el tipo de emergencia</option>
                                    <option value="Policia">Policía</option>
                                    <option value="Bomberos">Bomberos</option>
                                    <option value="Medico">Médico</option>
                                </select>
                                <span asp-validation-for="EmergencyCategory" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Image" class="form-label fw-bold"></label>
                                <input asp-for="Image" type="file" class="form-control" accept="image/jpeg,image/jpg,image/png" />
                                <span asp-validation-for="Image" class="text-danger small"></span>
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i>JPG, PNG. Máx 5MB
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold"></label>
                                <textarea asp-for="Description" class="form-control" rows="4"
                                          placeholder="Describe la emergencia con el mayor detalle posible..." required></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>Ubicación de la Emergencia
                                </label>
                                <div class="alert alert-warning small mb-2">
                                    <i class="bi bi-hand-index-thumb me-1"></i>
                                    Haz clic en el mapa o arrastra el marcador <span class="badge bg-danger">🚨</span> para indicar la ubicación exacta de la emergencia.
                                </div>
                                <div id="map" style="height: 450px; border-radius: 12px;" class="border shadow-lg"></div>
                                <input asp-for="Latitude" type="hidden" id="latitude" />
                                <input asp-for="Longitude" type="hidden" id="longitude" />
                                <span asp-validation-for="Latitude" class="text-danger small d-block"></span>
                                <span asp-validation-for="Longitude" class="text-danger small d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label fw-bold"></label>
                                <input asp-for="Address" class="form-control"
                                       placeholder="Ej: Av. Heroínas #123" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LocationReference" class="form-label fw-bold"></label>
                                <input asp-for="LocationReference" class="form-control"
                                       placeholder="Ej: Cerca del parque, frente al banco" />
                                <span asp-validation-for="LocationReference" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Citizen" asp-action="Dashboard" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-send-fill me-2"></i>Reportar Emergencia
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map;
        let marker;
        const defaultLat = -17.3935;
        const defaultLng = -66.1570;

        function initMap(lat, lng) {
            map = L.map('map').setView([lat, lng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);

            const emergencyIcon = L.icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });

            marker = L.marker([lat, lng], {
                draggable: true,
                icon: emergencyIcon
            }).addTo(map);

            marker.bindPopup('<b>Ubicación de la emergencia</b><br>Arrastra el marcador para ajustar').openPopup();

            marker.on('dragend', function(e) {
                const position = marker.getLatLng();
                updateCoordinates(position.lat, position.lng);
            });

            map.on('click', function(e) {
                marker.setLatLng(e.latlng);
                updateCoordinates(e.latlng.lat, e.latlng.lng);
            });

            updateCoordinates(lat, lng);
        }

        function updateCoordinates(lat, lng) {
            document.getElementById('latitude').value = lat.toFixed(8);
            document.getElementById('longitude').value = lng.toFixed(8);
        }

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    initMap(position.coords.latitude, position.coords.longitude);
                },
                function(error) {
                    console.log('Error obteniendo ubicación:', error);
                    initMap(defaultLat, defaultLng);
                }
            );
        } else {
            initMap(defaultLat, defaultLng);
        }
    </script>
}