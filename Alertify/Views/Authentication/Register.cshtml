@model Alertify.ViewModels.Authentication.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear Cuenta - Alertify</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/Authentication/Register.css" asp-append-version="true" />
</head>

<body class="d-flex align-items-center justify-content-center min-vh-100 py-5">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-6">

                <main class="register-card p-4 p-md-5 mx-auto">

                    <div class="text-center mb-4">
                        <div class="brand-icon">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">Crear Cuenta</h4>
                        <p class="text-muted small mb-0">Únete a Alertify y gestiona tus emergencias</p>
                    </div>

                    <form asp-controller="Authentication" asp-action="Register" method="post">

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 small" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                <div>Por favor revisa los errores del formulario.</div>
                            </div>
                        }

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 small" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                                <div>@ViewBag.ErrorMessage</div>
                            </div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control" placeholder="Nombre" required />
                                    <label asp-for="FirstName">Nombre</label>
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small ms-1"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FirstLastName" class="form-control" placeholder="1er Apellido" required />
                                    <label asp-for="FirstLastName">1er Apellido</label>
                                </div>
                                <span asp-validation-for="FirstLastName" class="text-danger small ms-1"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="SecondLastName" class="form-control" placeholder="2do Apellido" />
                                    <label asp-for="SecondLastName">2do Apellido <span class="text-muted opacity-50">(Op)</span></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Phone" type="tel" class="form-control" placeholder="Teléfono" />
                                    <label asp-for="Phone">Teléfono / Celular</label>
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small ms-1"></span>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control" placeholder="correo@ejemplo.com" required />
                            <label asp-for="Email">Correo Electrónico</label>
                            <span asp-validation-for="Email" class="text-danger small ms-1"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="mb-1">
                                    <div class="position-relative">
                                        <div class="form-floating">
                                            <input asp-for="Password" type="password" class="form-control pe-5" id="regPass" placeholder="Contraseña" required />
                                            <label asp-for="Password">Contraseña</label>
                                        </div>
                                        <button type="button" class="password-toggle position-absolute top-50 end-0 translate-middle-y me-3" onclick="togglePass('regPass', this)">
                                            <i class="bi bi-eye-slash fs-5"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small ms-1"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-1">
                                    <div class="position-relative">
                                        <div class="form-floating">
                                            <input asp-for="ConfirmPassword" type="password" class="form-control pe-5" id="confPass" placeholder="Confirmar" required />
                                            <label asp-for="ConfirmPassword">Confirmar</label>
                                        </div>
                                        <button type="button" class="password-toggle position-absolute top-50 end-0 translate-middle-y me-3" onclick="togglePass('confPass', this)">
                                            <i class="bi bi-eye-slash fs-5"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small ms-1"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-primary btn-register rounded-pill shadow-sm">
                                Registrarse
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="text-muted small mb-2">¿Ya tienes una cuenta?</p>
                            <a href="@Url.Action("Login", "Authentication")" class="btn btn-outline-secondary w-100 rounded-pill border">
                                Iniciar Sesión
                            </a>
                        </div>

                    </form>
                </main>

                <footer class="text-center mt-4">
                    <p class="text-muted small opacity-50">&copy; @DateTime.Now.Year Alertify - Gestión de Emergencias</p>
                </footer>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function togglePass(id, el) {
            const input = document.getElementById(id);
            const icon = el.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            } else {
                input.type = "password";
                icon.classList.add("bi-eye-slash");
                icon.classList.remove("bi-eye");
            }
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>