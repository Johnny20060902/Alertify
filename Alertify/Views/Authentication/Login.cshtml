@model Alertify.ViewModels.Authentication.LoginCredentials
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Alertify</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/Authentication/Login.css" asp-append-version="true" />
</head>

<body class="d-flex align-items-center justify-content-center min-vh-100 py-4">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">

                <main class="login-card p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="brand-icon">
                            <i class="bi bi-broadcast"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">Bienvenido</h4>
                        <p class="text-muted small mb-0">Ingresa tus credenciales para continuar</p>
                    </div>

                    <form asp-controller="Authentication" asp-action="Login" method="post">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 small" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                                <div>@ViewBag.ErrorMessage</div>
                            </div>
                        }

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 small" role="alert">
                                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                <div>@TempData["SuccessMessage"]</div>
                            </div>
                        }

                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control" placeholder="nombre@ejemplo.com" required />
                            <label asp-for="Email">Correo Electrónico</label>
                            <span asp-validation-for="Email" class="text-danger small ms-1"></span>
                        </div>

                        <div class="mb-3">
                            <div class="position-relative">
                                <div class="form-floating">
                                    <input asp-for="Password" type="password" class="form-control pe-5" id="loginPass" placeholder="Contraseña" required />
                                    <label asp-for="Password">Contraseña</label>
                                </div>
                                <button type="button" class="password-toggle position-absolute top-50 end-0 translate-middle-y me-3" onclick="togglePass('loginPass', this)">
                                    <i class="bi bi-eye-slash fs-5"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small ms-1"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label text-muted small">Recordarme</label>
                            </div>
                            <a asp-controller="Authentication" asp-action="ForgotPassword" class="small text-decoration-none text-primary fw-bold">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-primary btn-login rounded-pill shadow-sm">
                                Iniciar Sesión
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="text-muted small mb-3">¿Aún no tienes una cuenta?</p>
                            <a asp-controller="Authentication" asp-action="Register" class="btn btn-light rounded-pill w-100 text-dark fw-bold border">
                                Crear cuenta nueva
                            </a>
                        </div>
                    </form>
                </main>

                <footer class="text-center mt-4">
                    <p class="text-muted small opacity-50">&copy; @DateTime.Now.Year Alertify - Gestión de Emergencias</p>
                </footer>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function togglePass(id, el) {
            const input = document.getElementById(id);
            const icon = el.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            } else {
                input.type = "password";
                icon.classList.add("bi-eye-slash");
                icon.classList.remove("bi-eye");
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>