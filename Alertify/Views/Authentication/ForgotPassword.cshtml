@model Alertify.ViewModels.Authentication.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar contraseña - Alertify</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/Authentication/ForgotPassword.css" asp-append-version="true" />
</head>

<body class="d-flex align-items-center justify-content-center min-vh-100 py-4">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">

                <main class="recovery-card p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="icon-header">
                            <i class="bi bi-envelope-exclamation-fill"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">¿Olvidaste tu contraseña?</h4>
                        <p class="text-muted small mb-0">
                            Ingresa tu correo y te enviaremos las instrucciones para recuperarla.
                        </p>
                    </div>

                    <form asp-controller="Authentication" asp-action="ForgotPassword" method="post">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 small" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                                <div>@ViewBag.ErrorMessage</div>
                            </div>
                        }

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 small" role="alert">
                                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                <div>@TempData["SuccessMessage"]</div>
                            </div>
                        }

                        <div class="form-floating mb-4">
                            <input asp-for="Email" type="email" class="form-control" placeholder="nombre@ejemplo.com" required />
                            <label asp-for="Email">Correo electrónico</label>
                            <span asp-validation-for="Email" class="text-danger small ms-1"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-action rounded-pill shadow-sm">
                                Enviar enlace
                            </button>
                            <a asp-controller="Authentication" asp-action="Login" class="btn btn-light btn-action rounded-pill border text-muted">
                                Cancelar
                            </a>
                        </div>

                    </form>
                </main>

                <div class="text-center mt-4">
                    <p class="text-muted small opacity-50">
                        <i class="bi bi-shield-check me-1"></i>Sistema seguro de recuperación
                    </p>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>