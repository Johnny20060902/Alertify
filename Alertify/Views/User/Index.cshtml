@model IEnumerable<Alertify.Models.User>

@{
    ViewData["Title"] = "Usuarios del Sistema";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Gestión de Usuarios</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
        </a>
    </div>

    <!-- TABLA -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Datos</th>
                        <th>Rol</th>
                        <th>Último Acceso</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var roleColor = item.Role switch
                        {
                            "Admin" => "danger",
                            "Ciudadano" => "primary",
                            "Operador" => "warning",
                            _ => "secondary"
                        };

                        var statusColor = item.Status == "Activo" ? "success" : "secondary";

                        <tr>

                            <!-- FOTO O INICIAL -->
                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    @if (!string.IsNullOrEmpty(item.ProfilePhotoURL))
                                    {
                                        <!-- FOTO -->
                                        <img src="@item.ProfilePhotoURL"
                                             class="rounded-circle border"
                                             style="width: 48px; height: 48px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        var fullName = $"{item.FirstName} {item.FirstLastName}".Trim();
                                        var initial = !string.IsNullOrWhiteSpace(fullName)
                                        ? fullName.Substring(0, 1).ToUpper()
                                        : "U";

                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                             style="width: 48px; height: 48px; font-size: 20px; font-weight: 600;">
                                            @initial
                                        </div>
                                    }


                                    <div>
                                        <strong>@item.FirstName @item.FirstLastName</strong>
                                        <div class="text-muted small">@item.Email</div>
                                    </div>

                                </div>
                            </td>

                            <!-- DATOS -->
                            <td>
                                <div class="small">
                                    <i class="bi bi-telephone text-muted"></i> @item.Phone <br />
                                    <i class="bi bi-credit-card text-muted"></i> @item.NationalID
                                </div>
                            </td>

                            <!-- ROL -->
                            <td>
                                <span class="badge bg-@roleColor">@item.Role</span>
                            </td>

                            <!-- ULTIMO ACCESO -->
                            <td>
                                @if (item.LastAccess != null)
                                {
                                    <span class="small text-muted">@item.LastAccess?.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="small text-muted fst-italic">Nunca</span>
                                }
                            </td>

                            <!-- ESTADO -->
                            <td>
                                <span class="badge bg-@statusColor">@item.Status</span>
                            </td>

                            <!-- ACCIONES -->
                            <td class="text-end">

                                <a asp-action="Details" asp-route-id="@item.UserID"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.UserID"
                                   class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.UserID"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>

                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>
