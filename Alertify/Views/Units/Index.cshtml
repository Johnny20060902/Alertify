@model IEnumerable<Alertify.Models.Unit>

@{
    ViewData["Title"] = "Unidades Disponibles";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-car-front-fill text-success me-2"></i>Unidades Disponibles
            </h2>
            <p class="text-muted mb-0">Gestiona todas las unidades de emergencia</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>Nueva Unidad
        </a>
    </div>

    <!-- Filtro por estatus -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <i class="bi bi-funnel me-2"></i>Filtrar por Estatus
            </h5>
        </div>
        <div class="card-body">
            <div class="btn-group flex-wrap" role="group">
                <button type="button" class="btn btn-outline-secondary active filter-btn" data-filter="all">
                    <i class="bi bi-diagram-3 me-1"></i>Todas
                </button>
                <button type="button" class="btn btn-outline-success filter-btn" data-filter="Disponible">
                    <i class="bi bi-check-circle me-1"></i>Disponibles
                </button>
                <button type="button" class="btn btn-outline-warning filter-btn" data-filter="EnServicio">
                    <i class="bi bi-exclamation-triangle me-1"></i>En Servicio
                </button>
                <button type="button" class="btn btn-outline-danger filter-btn" data-filter="Mantenimiento">
                    <i class="bi bi-tools me-1"></i>Mantenimiento
                </button>
            </div>
        </div>
    </div>

    <!-- Tarjetas de Unidades -->
    <div class="row g-3">
        @foreach (var item in Model)
        {
            var statusColor = item.UnitStatus == "Disponible" ? "success" : 
                            item.UnitStatus == "EnServicio" ? "warning" : "danger";
            var statusIcon = item.UnitStatus == "Disponible" ? "check-circle" : 
                           item.UnitStatus == "EnServicio" ? "exclamation-triangle" : "tools";

            <div class="col-md-6 col-lg-4 unit-card-container" data-status="@item.UnitStatus">
                <div class="card h-100 shadow-sm border-0 unit-card transition-all">
                    <div class="card-header bg-light border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">@item.Code</span>
                            <span class="badge bg-@statusColor">
                                <i class="bi bi-@statusIcon me-1"></i>@item.UnitStatus
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-car-front-fill text-success me-2"></i>@item.Name
                        </h5>
                        
                        <div class="info-section mb-3">
                            <p class="text-muted small mb-2">
                                <i class="bi bi-tag me-2"></i><strong>Tipo de Servicio:</strong> @item.ServiceType
                            </p>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-building me-2"></i><strong>Estación:</strong> @item.Station?.Name
                            </p>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-person me-2"></i><strong>Responsable:</strong> @item.ResponsiblePerson
                            </p>
                        </div>

                        <hr class="my-2">

                        <div class="contact-section">
                            <p class="text-muted small mb-1">
                                <i class="bi bi-envelope me-2"></i>@item.ContactEmail
                            </p>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-telephone me-2"></i>@item.ContactPhone
                            </p>
                        </div>
                    </div>
                    <div class="card-footer bg-light border-0">
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="Edit" asp-route-id="@item.UnitID" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil me-1"></i>Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.UnitID" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i>Ver
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.UnitID" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Eliminar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Actualizar botones activos
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const filter = this.dataset.filter;
                const cards = document.querySelectorAll('.unit-card-container');

                cards.forEach(card => {
                    if (filter === 'all' || card.dataset.status === filter) {
                        card.style.display = '';
                        setTimeout(() => card.classList.add('show'), 10);
                    } else {
                        card.style.display = 'none';
                        card.classList.remove('show');
                    }
                });
            });
        });
    </script>
}

<style>
    .unit-card {
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }

    .unit-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        border-left-color: #28a745;
    }

    .transition-all {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .info-section {
        background-color: #f8f9fa;
        padding: 12px;
        border-radius: 6px;
    }

    .contact-section {
        background-color: #e7f3ff;
        padding: 12px;
        border-radius: 6px;
        border-left: 3px solid #0d6efd;
    }
</style>
