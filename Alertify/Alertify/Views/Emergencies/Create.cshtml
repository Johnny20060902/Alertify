@model Alertify.Models.Emergency
@{
    ViewData["Title"] = "Crear Emergencia";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <h2 class="card-title mb-4"><i class="bi bi-exclamation-triangle-fill text-danger"></i> Reportar Nueva Emergencia</h2>
                    <hr />
                    
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <!-- CATEGORÍA -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="EmergencyCategory" class="form-label fw-bold">Categoría de Emergencia *</label>
                                <select asp-for="EmergencyCategory" class="form-select" required>
                                    <option value="">Seleccione una categoría</option>
                                    <option value="Incendio">Incendio</option>
                                    <option value="Accidente de Tránsito">Accidente de Tránsito</option>
                                    <option value="Robo o Asalto">Robo o Asalto</option>
                                    <option value="Violencia Doméstica">Violencia Doméstica</option>
                                    <option value="Emergencia Médica">Emergencia Médica</option>
                                    <option value="Desastre Natural">Desastre Natural</option>
                                    <option value="Corte de Energía">Corte de Energía</option>
                                    <option value="Fuga de Gas">Fuga de Gas</option>
                                    <option value="Persona Sospechosa">Persona Sospechosa</option>
                                    <option value="Otros">Otros</option>
                                </select>
                                <span asp-validation-for="EmergencyCategory" class="text-danger"></span>
                            </div>

                            <!-- PRIORIDAD -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Priority" class="form-label fw-bold">Nivel de Prioridad *</label>
                                <select asp-for="Priority" class="form-select" required>
                                    <option value="">Seleccione prioridad</option>
                                    <option value="Baja">Baja</option>
                                    <option value="Media">Media</option>
                                    <option value="Alta">Alta</option>
                                    <option value="Crítica">Crítica</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- DESCRIPCIÓN -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Descripción de la Emergencia</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describa con detalle la emergencia..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <!-- DIRECCIÓN -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Address" class="form-label fw-bold">Dirección</label>
                                <input asp-for="Address" class="form-control" placeholder="Calle, número..." />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <!-- REFERENCIA -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="LocationReference" class="form-label fw-bold">Referencia de Ubicación</label>
                                <input asp-for="LocationReference" class="form-control" placeholder="Puntos de referencia..." />
                                <span asp-validation-for="LocationReference" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- LATITUD Y LONGITUD (OCULTOS) -->
                        <input asp-for="Latitude" id="Latitude" type="hidden" />
                        <input asp-for="Longitude" id="Longitude" type="hidden" />

                        <!-- SUBIR IMAGEN -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Subir Imagen (opcional)</label>
                            <input type="file" class="form-control" id="imageInput" name="ImageFile" accept="image/*" />
                            <small class="text-muted">Máximo 5 MB</small>
                            <img id="previewImg" src="#" alt="Vista previa" class="img-fluid mt-2 d-none" style="max-height: 200px;" />
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-send"></i> Reportar Emergencia
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        var map = L.map('map').setView([-17.7833, -63.1821], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
        }).addTo(map);

        let marker;

        // CLICK EN MAPA
        map.on('click', function (e) {
            const lat = e.latlng.lat.toFixed(6);
            const lng = e.latlng.lng.toFixed(6);

            document.getElementById("Latitude").value = lat;
            document.getElementById("Longitude").value = lng;

            if (marker) map.removeLayer(marker);
            marker = L.marker([lat, lng]).addTo(map);
        });

        // UBICACIÓN AUTOMÁTICA
        document.getElementById("btnLocation").addEventListener("click", function () {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (pos) {
                    const lat = pos.coords.latitude.toFixed(6);
                    const lng = pos.coords.longitude.toFixed(6);

                    document.getElementById("Latitude").value = lat;
                    document.getElementById("Longitude").value = lng;

                    if (marker) map.removeLayer(marker);
                    marker = L.marker([lat, lng]).addTo(map);

                    map.setView([lat, lng], 16);
                });
            } else {
                alert("Geolocalización no disponible");
            }
        });

        // PREVIEW DE IMAGEN
        document.getElementById("imageInput").addEventListener("change", function (event) {
            const file = event.target.files[0];
            const img = document.getElementById("previewImg");

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    img.classList.remove("d-none");
                };
                reader.readAsDataURL(file);
            }
        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
