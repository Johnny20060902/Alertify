@model Alertify.Models.Emergency
@{
    ViewData["Title"] = "Actualizar Estado";
    var statusList = ViewBag.StatusList as List<string>;
}

<div class="container py-4">

    <h2 class="mb-3">
        <i class="bi bi-flag-fill text-primary"></i> Actualizar Estado de Emergencia
    </h2>

    <div class="card shadow-sm p-4">
        <h5 class="mb-3">
            Estado actual:
            <span class="badge bg-info">@Model.EmergencyStatus</span>
        </h5>

        <form method="post">
            <input type="hidden" name="emergencyId" value="@Model.EmergencyID" />

            <div class="mb-3">
                <label class="form-label fw-bold">Nuevo Estado</label>
                <select name="newStatus" class="form-select">
                    @foreach (var s in statusList)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Comentario</label>
                <textarea name="comment" class="form-control" rows="3"></textarea>
            </div>

            <button class="btn btn-primary w-100">
                <i class="bi bi-send"></i> Actualizar Estado
            </button>
        </form>
    </div>

    <div class="mt-3">
        <a href="/Admin/Emergencies" class="btn btn-outline-secondary">Volver</a>
    </div>

</div>
