## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Build Tools
*.builds
*.nuget.props
*.nuget.targets

# NuGet Packages
*.nupkg
*.snupkg
*.nuget.lock

# Miscellaneous files
*.log
*.class
*.o
*.so

# Rider files
.idea/

# Build folders
bin/
obj/
.vs/

# Output folder
[Oo]ut/

# ReSharper files
.resharper
.resharper.user

# Test Results
TestResults/

# Publish
PublishProfiles/

# Environment files
.env
.env.local

# Node modules (if using npm)
node_modules/

# dist folder
dist/

# Next.js
.next/

# Any other IDE files
*.swp
*.swo
*~
.DS_Store
